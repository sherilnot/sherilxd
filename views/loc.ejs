<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Urbanzy — Nearby Places</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --ink: #0d0d0d;
      --ink-2: #3a3a3a;
      --ink-3: #888;
      --surface: #f7f5f0;
      --card: #ffffff;
      --border: rgba(0,0,0,0.09);
      --border-strong: rgba(0,0,0,0.16);
      --accent: #1a56db;
      --accent-bg: #eef3ff;
      --accent-border: #c3d4fb;
      --green: #16a34a;
      --green-bg: #f0fdf4;
      --radius: 16px;
      --radius-sm: 10px;
      --font-display: 'Instrument Serif', Georgia, serif;
      --font-body: 'DM Sans', system-ui, sans-serif;
    }

    html, body {
      height: 100%;
      font-family: var(--font-body);
      background: var(--surface);
      color: var(--ink);
      font-size: 15px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      overflow: hidden;
    }

    /* ── PARALLAX BG ── */
    .parallax-bg {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }

    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(72px);
      opacity: 0.45;
      will-change: transform;
      transition: transform 0.12s cubic-bezier(0.23,1,0.32,1);
    }

    .orb-1 { width:520px;height:520px;background:radial-gradient(circle,#bfdbfe,#dbeafe);top:-120px;left:-100px; }
    .orb-2 { width:400px;height:400px;background:radial-gradient(circle,#c7d2fe,#e0e7ff);bottom:-80px;right:-80px; }
    .orb-3 { width:280px;height:280px;background:radial-gradient(circle,#d1fae5,#ecfdf5);top:40%;left:38%;opacity:0.3; }
    .orb-4 { width:180px;height:180px;background:radial-gradient(circle,#fde68a,#fef9c3);top:15%;right:22%;opacity:0.35; }

    .parallax-bg::after {
      content:'';position:absolute;inset:0;
      background-image:linear-gradient(rgba(0,0,0,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(0,0,0,0.03) 1px,transparent 1px);
      background-size:40px 40px;
    }

    /* ── DESKTOP SHELL ── */
    .shell {
      position: relative;
      z-index: 1;
      height: 100vh;
      display: grid;
      grid-template-rows: auto 1fr;
      max-width: 1280px;
      margin: 0 auto;
      padding: 18px 20px;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 0 16px;
    }

    .logo { display:flex;align-items:baseline;gap:10px; }
    .logo-name { font-family:var(--font-display);font-size:26px;letter-spacing:-0.5px;color:var(--ink); }
    .logo-name em { font-style:italic;color:var(--accent); }
    .logo-tagline { font-size:12px;color:var(--ink-3);letter-spacing:0.04em; }

    .body {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 14px;
      min-height: 0;
    }

    .sidebar { display:flex;flex-direction:column;gap:12px; }

    .card {
      background: rgba(255,255,255,0.78);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255,255,255,0.9);
      border-radius: var(--radius);
      padding: 18px;
      box-shadow: 0 2px 16px rgba(0,0,0,0.05);
    }

    .section-label {
      font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;
      color:var(--ink-3);margin-bottom:12px;display:flex;align-items:center;gap:7px;
    }
    .section-label i { font-size:12px; }

    .radius-num { font-family:var(--font-display);font-size:42px;line-height:1;color:var(--ink);margin-bottom:2px; }
    .radius-unit { font-size:16px;color:var(--ink-3);font-style:italic; }
    .radius-hint { font-size:12px;color:var(--ink-3);margin-bottom:14px; }

    input[type="range"] {
      -webkit-appearance:none;width:100%;height:4px;border-radius:99px;
      background:linear-gradient(to right,var(--accent) var(--pct,10%),#e0e0e0 var(--pct,10%));
      outline:none;cursor:pointer;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance:none;width:18px;height:18px;border-radius:50%;
      background:#fff;border:2px solid var(--accent);
      box-shadow:0 2px 8px rgba(26,86,219,.25);cursor:pointer;
    }

    .cat-grid { display:grid;grid-template-columns:1fr 1fr;gap:8px; }

    .cat-pill {
      display:flex;align-items:center;gap:8px;padding:9px 12px;
      border-radius:var(--radius-sm);border:1px solid var(--border);
      background:rgba(247,245,240,0.7);font-size:13px;cursor:pointer;
      transition:all .15s;user-select:none;color:var(--ink-2);
    }
    .cat-pill i { font-size:14px;color:var(--ink-3);transition:color .15s; }
    .cat-pill.active { background:var(--accent-bg);border-color:var(--accent-border);color:var(--accent); }
    .cat-pill.active i { color:var(--accent); }
    .cat-pill input[type="checkbox"] { display:none; }

    .btn {
      display:flex;align-items:center;justify-content:center;gap:8px;
      width:100%;padding:11px;border-radius:var(--radius-sm);
      font-size:13px;font-weight:500;cursor:pointer;transition:all .14s;
      font-family:var(--font-body);border:1px solid transparent;
    }
    .btn-outline { background:rgba(255,255,255,0.8);border-color:var(--border-strong);color:var(--ink-2); }
    .btn-outline:hover { background:var(--surface); }
    .btn-primary { background:var(--ink);color:#fff; }
    .btn-primary:hover { background:#222; }
    .btn-primary:active { transform:scale(.98); }
    .btn-gap { display:flex;flex-direction:column;gap:8px; }

    .status-line { font-size:11px;color:var(--ink-3);margin-top:4px;display:flex;align-items:center;gap:5px; }
    .status-line.ok { color:var(--green); }
    .status-line.err { color:#dc2626; }

    .right { display:grid;grid-template-rows:1fr auto;gap:12px;min-height:0; }

    .map-wrap {
      border-radius:var(--radius);border:1px solid rgba(255,255,255,0.9);
      overflow:hidden;position:relative;background:#e8ebe4;min-height:300px;
      box-shadow:0 2px 16px rgba(0,0,0,0.07);
    }
    #map { width:100%;height:100%;min-height:300px; }

    .map-empty {
      position:absolute;inset:0;display:flex;flex-direction:column;
      align-items:center;justify-content:center;gap:10px;color:#aaa;pointer-events:none;
    }
    .map-empty i { font-size:32px;opacity:.5; }
    .map-empty p { font-size:13px; }

    .map-badge {
      position:absolute;top:12px;left:12px;
      background:rgba(255,255,255,.92);backdrop-filter:blur(8px);
      border:1px solid var(--border-strong);border-radius:var(--radius-sm);
      padding:5px 11px;font-size:11px;font-weight:600;letter-spacing:.06em;
      text-transform:uppercase;color:var(--ink-2);z-index:999;
      display:flex;align-items:center;gap:6px;
    }

    .results-bar {
      background:rgba(255,255,255,0.78);backdrop-filter:blur(18px);
      -webkit-backdrop-filter:blur(18px);border:1px solid rgba(255,255,255,0.9);
      border-radius:var(--radius);overflow:hidden;box-shadow:0 2px 16px rgba(0,0,0,0.05);
    }
    .results-head { display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--border); }
    .results-title { font-size:13px;font-weight:600;display:flex;align-items:center;gap:7px; }
    .result-count { font-size:11px;padding:3px 10px;border-radius:999px;background:var(--surface);border:1px solid var(--border);color:var(--ink-3); }

    .results-scroll {
      display:flex;flex-direction:row;gap:10px;padding:12px 14px;
      overflow-x:auto;scrollbar-width:thin;min-height:96px;
    }

    .poi-card {
      flex-shrink:0;display:flex;align-items:center;gap:10px;padding:10px 14px;
      border-radius:var(--radius-sm);border:1px solid var(--border);
      background:rgba(247,245,240,0.7);min-width:200px;transition:all .14s;cursor:pointer;
    }
    .poi-card:hover { border-color:var(--accent-border);background:var(--accent-bg); }

    .poi-icon { width:36px;height:36px;border-radius:9px;background:var(--accent-bg);color:var(--accent);display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0; }
    .poi-icon.shop { background:var(--green-bg);color:var(--green); }
    .poi-icon.hotel { background:#faf5ff;color:#7c3aed; }
    .poi-name { font-size:13px;font-weight:500;color:var(--ink); }
    .poi-meta { display:flex;align-items:center;gap:6px;margin-top:3px; }
    .poi-dist { font-size:11px;color:var(--ink-3); }
    .poi-tag { font-size:10px;padding:2px 7px;border-radius:999px;background:var(--accent-bg);color:var(--accent);border:1px solid var(--accent-border); }

    .list-empty { display:flex;align-items:center;justify-content:center;gap:8px;color:var(--ink-3);font-size:12px;width:100%; }

    @keyframes spin { to { transform:rotate(360deg); } }
    .spin { animation:spin .8s linear infinite;display:inline-block; }
    @keyframes youPulse {
      0%   { transform:scale(1);  opacity:.7; }
      70%  { transform:scale(2.6);opacity:0; }
      100% { transform:scale(2.6);opacity:0; }
    }

    /* ═══════════════════════════════
       MOBILE LAYOUT
    ═══════════════════════════════ */
    @media (max-width: 768px) {
      html, body { overflow: auto; height: auto; }

      .parallax-bg { position: fixed; }
      .orb { filter: blur(48px); }

      .shell {
        height: auto;
        min-height: 100vh;
        padding: 14px 14px 80px; /* bottom padding for the FAB */
        grid-template-rows: auto 1fr;
      }

      .topbar { padding: 0 0 12px; }
      .logo-name { font-size: 22px; }
      .logo-tagline { display: none; }

      /* Stack sidebar below map on mobile */
      .body {
        grid-template-columns: 1fr;
        grid-template-rows: auto auto;
        gap: 12px;
      }

      /* On mobile: map comes first, sidebar below */
      .right { order: -1; grid-template-rows: 280px auto; }
      .sidebar { order: 1; }

      /* Sidebar cards go horizontal scroll on mobile */
      .sidebar {
        flex-direction: row;
        overflow-x: auto;
        gap: 10px;
        padding-bottom: 4px;
        scrollbar-width: none;
      }
      .sidebar::-webkit-scrollbar { display: none; }

      .card {
        flex-shrink: 0;
        padding: 14px;
      }

      /* Radius card compact */
      .card:nth-child(1) { min-width: 200px; }
      .radius-num { font-size: 32px; }
      .radius-hint { display: none; }

      /* Category card */
      .card:nth-child(2) { min-width: 280px; }
      .cat-grid { grid-template-columns: 1fr 1fr 1fr; gap: 6px; }
      .cat-pill { padding: 7px 8px; font-size: 12px; gap: 5px; }
      .cat-pill i { font-size: 12px; }

      /* Actions card */
      .card:nth-child(3) { min-width: 200px; }
      .btn { padding: 10px; font-size: 12px; }

      /* Map height on mobile */
      #map { min-height: 280px; }
      .map-wrap { min-height: 280px; }

      /* Results: vertical list instead of horizontal scroll on mobile */
      .results-scroll {
        flex-direction: column;
        overflow-x: hidden;
        overflow-y: auto;
        max-height: 260px;
        min-height: unset;
        padding: 10px 12px;
      }

      .poi-card { min-width: unset; width: 100%; }

      /* Floating action button on mobile */
      .mobile-fab {
        display: flex;
      }
    }

    /* Hide FAB on desktop */
    .mobile-fab {
      display: none;
      position: fixed;
      bottom: 20px;
      right: 20px;
      z-index: 999;
      gap: 10px;
    }

    .fab-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 13px 18px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 600;
      font-family: var(--font-body);
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 20px rgba(0,0,0,0.18);
      transition: transform .14s, box-shadow .14s;
    }

    .fab-btn:active { transform: scale(.96); }

    .fab-loc {
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(12px);
      color: var(--ink-2);
      border: 1px solid var(--border-strong);
      padding: 13px;
      border-radius: 50%;
      width: 50px;
      height: 50px;
      justify-content: center;
    }

    .fab-search {
      background: var(--ink);
      color: #fff;
    }
  </style>
</head>
<body>

  <div class="parallax-bg">
    <div class="orb orb-1" id="orb1"></div>
    <div class="orb orb-2" id="orb2"></div>
    <div class="orb orb-3" id="orb3"></div>
    <div class="orb orb-4" id="orb4"></div>
  </div>

  <div class="shell">

    <header class="topbar">
      <div class="logo">
        <span class="logo-name">Urban<em>zy</em></span>
        <span class="logo-tagline">discover what's around you</span>
      </div>
      <div class="status-line" id="status-line" style="margin-top:0">
        <i class="fa-regular fa-circle-info"></i> Location not set
      </div>
    </header>

    <div class="body">

      <aside class="sidebar">

        <!-- RADIUS -->
        <div class="card">
          <div class="section-label"><i class="fa-regular fa-circle-dot"></i> Radius</div>
          <div class="radius-num" id="rad-display">2.0 <span class="radius-unit">km</span></div>
          <div class="radius-hint">Distance from your location</div>
          <input type="range" id="rad" min="1" max="20" step="0.5" value="2"
            oninput="updateRadius(this.value)">
        </div>

        <!-- CATEGORIES -->
        <div class="card">
          <div class="section-label"><i class="fa-solid fa-layer-group"></i> Categories</div>
          <div class="cat-grid">
            <label class="cat-pill active">
              <input type="checkbox" name="preferences" value="food" checked>
              <i class="fa-solid fa-utensils"></i> Food
            </label>
            <label class="cat-pill active">
              <input type="checkbox" name="preferences" value="shopping" checked>
              <i class="fa-solid fa-bag-shopping"></i> Shopping
            </label>
            <label class="cat-pill active">
              <input type="checkbox" name="preferences" value="hotel" checked>
              <i class="fa-solid fa-bed"></i> Hotels
            </label>
            <label class="cat-pill">
              <input type="checkbox" name="preferences" value="park">
              <i class="fa-solid fa-tree"></i> Parks
            </label>
            <label class="cat-pill">
              <input type="checkbox" name="preferences" value="health">
              <i class="fa-solid fa-heart-pulse"></i> Health
            </label>
            <label class="cat-pill">
              <input type="checkbox" name="preferences" value="transport">
              <i class="fa-solid fa-bus"></i> Transit
            </label>
          </div>
        </div>

        <!-- ACTIONS (desktop only — mobile uses FAB) -->
        <div class="card">
          <div class="section-label"><i class="fa-solid fa-bolt"></i> Actions</div>
          <div class="btn-gap">
            <button class="btn btn-outline" onclick="sendall()">
              <i class="fa-solid fa-location-crosshairs"></i> Use my location
            </button>
            <button class="btn btn-primary" onclick="submitSearch()">
              <i class="fa-solid fa-magnifying-glass"></i> Find places
            </button>
          </div>
        </div>

      </aside>

      <div class="right">

        <div class="map-wrap">
          <div id="map-empty" class="map-empty">
            <i class="fa-regular fa-map"></i>
            <p>Set your location to load the map</p>
          </div>
          <div id="map"></div>
          <div class="map-badge"><i class="fa-solid fa-map-pin"></i> Live Map</div>
        </div>

        <div class="results-bar">
          <div class="results-head">
            <div class="results-title">
              <i class="fa-solid fa-list-ul" style="color:var(--ink-3);font-size:13px"></i>
              Nearby Places
            </div>
            <span class="result-count" id="result-count">0 results</span>
          </div>
          <div class="results-scroll" id="results-list">
            <div class="list-empty">
              <i class="fa-regular fa-compass"></i>
              Hit "Find places" to see results
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- MOBILE FAB BUTTONS -->
  <div class="mobile-fab">
    <button class="fab-btn fab-loc" onclick="sendall()" title="Use my location">
      <i class="fa-solid fa-location-crosshairs"></i>
    </button>
    <button class="fab-btn fab-search" onclick="submitSearch()">
      <i class="fa-solid fa-magnifying-glass"></i> Find places
    </button>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    /* ── PARALLAX ── */
    const orbs = [
      { el: document.getElementById('orb1'), dx: 0.025, dy: 0.018 },
      { el: document.getElementById('orb2'), dx: -0.03, dy: -0.022 },
      { el: document.getElementById('orb3'), dx: 0.015, dy: -0.012 },
      { el: document.getElementById('orb4'), dx: -0.02, dy: 0.028 },
    ];
    document.addEventListener('mousemove', e => {
      const cx = window.innerWidth / 2, cy = window.innerHeight / 2;
      const mx = e.clientX - cx, my = e.clientY - cy;
      orbs.forEach(o => {
        o.el.style.transform = `translate(${mx * o.dx}px, ${my * o.dy}px)`;
      });
    });

    let map = null, userMarker = null, placeLayers = [];

    const categoryIconMap = {
      food:      { cls: '',      icon: 'fa-utensils' },
      shopping:  { cls: 'shop',  icon: 'fa-bag-shopping' },
      hotel:     { cls: 'hotel', icon: 'fa-bed' },
      park:      { cls: '',      icon: 'fa-tree' },
      health:    { cls: '',      icon: 'fa-heart-pulse' },
      transport: { cls: '',      icon: 'fa-bus' }
    };

    function updateRadius(val) {
      const pct = ((val - 1) / (20 - 1)) * 100;
      document.getElementById('rad').style.setProperty('--pct', pct + '%');
      document.getElementById('rad-display').innerHTML =
        parseFloat(val).toFixed(1) + ' <span class="radius-unit">km</span>';
    }
    updateRadius(2);

    document.querySelectorAll('.cat-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        const cb = pill.querySelector('input[type="checkbox"]');
        pill.classList.toggle('active', cb.checked);
      });
    });

    function setStatus(msg, type) {
      const el = document.getElementById('status-line');
      el.className = 'status-line' + (type ? ' ' + type : '');
      el.innerHTML = msg;
    }

    function haversine(lat1, lon1, lat2, lon2) {
      const R = 6371000, toRad = d => d * Math.PI / 180;
      const dLat = toRad(lat2 - lat1), dLon = toRad(lon2 - lon1);
      const a = Math.sin(dLat/2)**2 + Math.cos(toRad(lat1))*Math.cos(toRad(lat2))*Math.sin(dLon/2)**2;
      return (R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a)) / 1000);
    }

    function initMap(lat, lon, places) {
      document.getElementById('map-empty').style.display = 'none';

      const youIcon = L.divIcon({
        className: '',
        html: `<div style="width:20px;height:20px;border-radius:50%;background:#1a56db;border:3px solid #fff;box-shadow:0 0 0 5px rgba(26,86,219,0.25),0 2px 8px rgba(0,0,0,0.3);position:relative;">
          <div style="position:absolute;inset:-8px;border-radius:50%;background:rgba(26,86,219,0.18);animation:youPulse 2s ease-out infinite;"></div>
        </div>`,
        iconSize: [20,20], iconAnchor: [10,10], popupAnchor: [0,-14]
      });

      if (!map) {
        map = L.map('map').setView([lat, lon], 14);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '© OpenStreetMap contributors'
        }).addTo(map);
        userMarker = L.marker([lat, lon], { icon: youIcon })
          .bindPopup('<b>📍 You are here</b>').addTo(map);
      } else {
        map.setView([lat, lon], 14);
        userMarker.setLatLng([lat, lon]);
        userMarker.setIcon(youIcon);
        placeLayers.forEach(l => map.removeLayer(l));
        placeLayers = [];
      }

      places.forEach(place => {
        const m = L.marker([place.lat, place.lon])
          .bindPopup(`<b>${place.name}</b><br>${place.types.join(', ')}`)
          .addTo(map);
        placeLayers.push(m);
      });
    }

    function renderPlaces(results) {
      const list = document.getElementById('results-list');
      document.getElementById('result-count').textContent =
        results.length + ' result' + (results.length !== 1 ? 's' : '');

      if (!results.length) {
        list.innerHTML = '<div class="list-empty"><i class="fa-regular fa-compass"></i> No places found — try a wider radius</div>';
        return;
      }

      list.innerHTML = results.map(p => {
        const cat = (p.types && p.types[0]) || 'food';
        const info = categoryIconMap[cat] || categoryIconMap.food;
        return `<div class="poi-card">
          <div class="poi-icon ${info.cls}"><i class="fa-solid ${info.icon}"></i></div>
          <div>
            <div class="poi-name">${p.name}</div>
            <div class="poi-meta">
              <span class="poi-dist">${p.distance} km</span>
              <span class="poi-tag">${cat}</span>
            </div>
          </div>
        </div>`;
      }).join('');
    }

    let currentLat = null, currentLon = null;

    function sendall() {
      setStatus('<i class="fa-solid fa-circle-notch spin"></i> Getting location…');
      navigator.geolocation.getCurrentPosition(pos => {
        currentLat = pos.coords.latitude;
        currentLon = pos.coords.longitude;
        console.log(currentLat, currentLon);
        setStatus('<i class="fa-solid fa-circle-check"></i> Location set', 'ok');
      }, handleError);
    }

    async function submitSearch() {
      const radius = document.getElementById('rad').value;
      const prefs = [...document.querySelectorAll('input[name="preferences"]:checked')].map(cb => cb.value);

      if (!currentLat || !currentLon) {
        setStatus('<i class="fa-solid fa-triangle-exclamation"></i> Set your location first', 'err');
        return;
      }
      if (!prefs.length) {
        setStatus('<i class="fa-solid fa-triangle-exclamation"></i> Select a category', 'err');
        return;
      }

      const btns = document.querySelectorAll('.btn-primary, .fab-search');
      btns.forEach(b => { b.innerHTML = '<i class="fa-solid fa-circle-notch spin"></i> Searching…'; b.disabled = true; });

      try {
        const res = await fetch('/api/location', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ lat: currentLat, lon: currentLon, radius, prefs })
        });

        if (!res.ok) {
          setStatus('<i class="fa-solid fa-triangle-exclamation"></i> ' + await res.text(), 'err');
          return;
        }

        const data = await res.json();
        renderPlaces(data.results);
        initMap(currentLat, currentLon, data.results);
        setStatus(`<i class="fa-solid fa-circle-check"></i> Found ${data.count} place(s)`, 'ok');

        // On mobile, scroll map into view after search
        if (window.innerWidth <= 768) {
          document.querySelector('.map-wrap').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      } catch (err) {
        setStatus('<i class="fa-solid fa-triangle-exclamation"></i> Request failed', 'err');
        console.error(err);
      } finally {
        document.querySelectorAll('.btn-primary').forEach(b => {
          b.innerHTML = '<i class="fa-solid fa-magnifying-glass"></i> Find places'; b.disabled = false;
        });
        document.querySelectorAll('.fab-search').forEach(b => {
          b.innerHTML = '<i class="fa-solid fa-magnifying-glass"></i> Find places'; b.disabled = false;
        });
      }
    }

    function handleError(err) {
      console.error('Geolocation error:', err);
      setStatus('<i class="fa-solid fa-triangle-exclamation"></i> Could not get location', 'err');
    }
  </script>
</body>
</html>
