<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Nearby Places Finder</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Optional Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel = "stylesheet" href = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
      
  <style>
    :root {
      --bg: #f5f7fb;
      --card-bg: #ffffff;
      --card-alt: #f9fafb;
      --accent: #2563eb;
      --accent-soft: rgba(37, 99, 235, 0.09);
      --accent-strong: #1d4ed8;
      --border-subtle: rgba(148, 163, 184, 0.55);
      --text-main: #111827;
      --text-muted: #6b7280;
      --radius-lg: 18px;
      --shadow-soft: 0 18px 38px rgba(15, 23, 42, 0.08);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: radial-gradient(circle at top, #e5edff 0, #f5f7fb 45%, #eef2ff 100%);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: stretch;
      padding: 24px;
       min-height: 100vh;
      height: 100vh;        /* 🔑 lock height */
        overflow: hidden;    /* 🔑 no page scroll */
    }

    .page {
      height: 100%;
      width: 100%;
      max-width: 1200px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
  


    header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }

    header h1 {
      font-size: 1.8rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      color: #0f172a;
    }

    header p {
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    .badge {
      border-radius: 999px;
      border: 1px solid rgba(148,163,184,0.4);
      padding: 4px 10px;
      font-size: 0.75rem;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #ffffff;
      box-shadow: 0 6px 18px rgba(148, 163, 184, 0.25);
    }

    .badge-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: #22c55e;
      box-shadow: 0 0 0 4px rgba(34,197,94,0.18);
    }

    main {
      flex: 1;
  min-height: 0; 
      display: flex;
      flex-direction: column;
      gap: 16px;
      flex: 1;
    }

    .card {
      background: linear-gradient(135deg, #ffffff, #f4f7ff);
      border-radius: var(--radius-lg);
      border: 1px solid rgba(209, 213, 219, 0.9);
      box-shadow: var(--shadow-soft);
      padding: 18px 18px 14px;
    }

    .card-inner {
      background: radial-gradient(circle at top right, rgba(191, 219, 254, 0.55), #ffffff);
      border-radius: calc(var(--radius-lg) - 4px);
      padding: 16px 18px;
      border: 1px solid rgba(209, 213, 219, 0.8);
    }

    .form-layout {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      align-items: flex-end;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field label {
      font-size: 0.85rem;
      font-weight: 500;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .field small {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .input, .select {
      width: 100%;
      padding: 9px 12px;
      border-radius: 999px;
      border: 1px solid var(--border-subtle);
      background: #ffffff;
      color: var(--text-main);
      font-size: 0.9rem;
      outline: none;
      transition: border 0.16s ease, box-shadow 0.16s ease, background 0.16s ease, transform 0.08s ease;
    }

    .input:focus, .select:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 1px rgba(37, 99, 235, 0.45), 0 0 0 6px rgba(191, 219, 254, 0.8);
      background: #f9fbff;
      transform: translateY(-1px);
    }

    .pill-group {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid rgba(209, 213, 219, 0.9);
      background: linear-gradient(135deg, #ffffff, #f9fafb);
      font-size: 0.8rem;
      cursor: pointer;
      user-select: none;
      transition: background 0.16s ease, border 0.16s ease, transform 0.1s ease, box-shadow 0.16s ease;
    }

    .pill input {
      accent-color: var(--accent);
    }

    .pill:hover {
      border-color: var(--accent);
      transform: translateY(-1px);
      box-shadow: 0 8px 16px rgba(148, 163, 184, 0.3);
    }

    .btn-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: flex-end;
    }

    .btn {
      border-radius: 999px;
      padding: 8px 15px;
      border: 1px solid transparent;
      font-size: 0.9rem;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: background 0.16s ease, transform 0.1s ease, box-shadow 0.16s ease, border 0.16s ease;
      white-space: nowrap;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--accent), var(--accent-strong));
      color: white;
      box-shadow: 0 12px 26px rgba(37, 99, 235, 0.35);
    }

    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 14px 30px rgba(37, 99, 235, 0.45);
    }

    .btn-ghost {
      background: #ffffff;
      color: var(--text-main);
      border-color: rgba(148, 163, 184, 0.7);
      box-shadow: 0 8px 16px rgba(148, 163, 184, 0.2);
    }

    .btn-ghost:hover {
      background: #f3f4ff;
      border-color: var(--accent);
      transform: translateY(-1px);
    }

    .status-text {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-top: 4px;
    }

    /* Bottom layout */
    .bottom-card {
      padding: 0;
      flex: 1;
  min-height: 0;
    }

    .bottom-inner {
      border-radius: calc(var(--radius-lg) - 4px);
      border: 1px solid rgba(209, 213, 219, 0.95);
      background: radial-gradient(circle at top left, rgba(219, 234, 254, 0.9), #ffffff);
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      
      flex: 1;
  min-height: 0;
    }

    .bottom-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 4px 2px;
    }

    .bottom-header h2 {
      font-size: 1rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .bottom-header span {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .bottom-panels {
      display: grid;
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1.1fr);
      gap: 10px;
      flex: 1;
  min-height: 0;
    }

    #map {
      width: 100%;
      height: 100%;
      min-height: 300px;

      border-radius: 16px;
      background: radial-gradient(circle at top, #e5e7eb, #ffffff);
      border: 1px solid rgba(209, 213, 219, 0.95);
      position: relative;
      overflow: hidden;
    }

    

    .list-panel {
      border-radius: 16px;
      background: #ffffff;
      border: 1px solid rgba(209, 213, 219, 0.9);
      display: flex;
      flex-direction: column;
      padding: 10px 12px;
      overflow: hidden;
      box-shadow: 0 10px 20px rgba(148, 163, 184, 0.18);
      height: 100%;
  min-height: 0;
    }

    .list-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 4px;
    }

    .list-header h3 {
      font-size: 0.95rem;
      font-weight: 600;
      color: #111827;
    }

    .list-header small {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    #results-list {
      list-style: none;
      margin-top: 4px;
      overflow-y: auto;
      padding-right: 4px;
      scrollbar-width: thin;
      flex: 1;
  min-height: 0;
  overflow-y: auto;
    }

    #results-list li {
      padding: 7px 8px;
      border-radius: 12px;
      border: 1px solid rgba(209, 213, 219, 0.9);
      background: radial-gradient(circle at top left, var(--accent-soft), #ffffff);
      font-size: 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 2px;
      margin-bottom: 6px;
    }

    .poi-name {
      font-weight: 500;
      color: #111827;
    }

    .poi-meta {
      font-size: 0.75rem;
      color: var(--text-muted);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .chip {
      border-radius: 999px;
      padding: 2px 8px;
      font-size: 0.7rem;
      background: rgba(22, 163, 74, 0.08);
      border: 1px solid rgba(22, 163, 74, 0.35);
      color: #15803d;
    }

    @media (max-width: 768px) {
      body {
        padding: 14px;
        overflow: auto;
      }
      .page {
        max-width: 100%;
      }
      .bottom-panels {
        grid-template-columns: 1fr;
      }
      #map::before {
        font-size: 0.8rem;
      }
    }
  </style>
</head>
<body>
  <div class="page">
    <header>
      <div>
        <h1>Urbanzy</h1>
        <p>Choose your preferences, we’ll show you what’s around.</p>
      </div>
      <div class="badge">
        <span class="badge-dot"></span>
        <span>Node + JS Practice</span>
      </div>
    </header>

    <main>
      <!-- Top: Form Card -->
      <section class="card">
        <div class="card-inner">
          <form class="form-layout" action="/api/pois" method="POST">
            <div class="field">
              <label for="radius">Radius (Kilo)</label>
              <input id="rad" name="radiusMeters" type="number" class="input" min="100" max="10000" value="1000">
              <small>How far from your location we should search.</small>
            </div>

            <div class="field">
              <label>Categories</label>
              <div class="pill-group">
                <label class="pill">
                  <input type="checkbox" name="preferences" value="food" checked>
                  <span>Food</span>
                </label>
                <label class="pill">
                  <input type="checkbox" name="preferences" value="shopping" checked>
                  <span>Shopping</span>
                </label>
                <label class="pill">
                  <input type="checkbox" name="preferences" value="hotel" checked>
                  <span>Hotel</span>
                </label>
                
              </div>
              <small>Select the types of places you’re interested in.</small>
            </div>

            <div class="field">
              <label>Actions</label>
              <div class="btn-row">
                <!-- You can hook this to JS later -->
                <button onclick="sendall()" type="button" class="btn btn-ghost">
                  📍 Use my location
                </button>
                <button type="submit" class="btn btn-primary">
                  🔍 Find places
                </button>
              </div>
              <div class="status-text">
                Location & search status will appear here.
              </div>
            </div>
          </form>
        </div>
      </section>

      <!-- Bottom: Map + List Card -->
      <section class="card bottom-card">
        <div class="bottom-inner">
          <div class="bottom-header">
            <h2>Results</h2>
            <span>Map & list of places</span>
          </div>
          <div class="bottom-panels">
            <div id="map"></div>
            <div class="list-panel">
              <div class="list-header">
                <h3>Nearby Places</h3>
                <small>Results will appear here</small>
              </div>
              <ul id="results-list">
                <!-- Example static item; you can remove when you wire JS -->
                <li>
                  <div class="poi-name">Sample Cafe</div>
                  <div class="poi-meta">
                    <span>320 m away</span>
                    <span class="chip">food</span>
                  </div>
                </li>
                <li>
                  <div class="poi-name">Demo Mall</div>
                  <div class="poi-meta">
                    <span>840 m away</span>
                    <span class="chip">shopping</span>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>
  <script src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
let map = null;
let marker = null;
const redIcon = new L.Icon({
  iconUrl: "https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-red.png",
  shadowUrl: "https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png",
  iconSize: [25, 41],
  iconAnchor: [12, 41],
  popupAnchor: [1, -34],
  shadowSize: [41, 41]
});


function initMap(lat, lon, places) {
  if(map==null){
    map = L.map("map").setView([lat, lon], 20);
    var layer = L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: "© OpenStreetMap contributors"
    });
    map.setView([lat, lon], 20);
    map.addLayer(layer);
    marker = L.marker([lat, lon],{icon: redIcon}).bindPopup("You are here"  );
    marker.addTo(map);

  } else {
    map.setView([lat, lon], 13);
    marker.setLatLng([lat, lon]); 
  }
  for (let place of places) {
    const placeMarker = L.marker([place.lat, place.lon]);
    placeMarker.bindPopup(`<b>${place.name}</b><br/>${place.types.join(", ")}`);
    placeMarker.addTo(map);
  }

  map.setView([lat, lon], 20);
}


 function renderPlaces(results) {
  const list = document.getElementById("results-list");

  // remove old items
  list.innerHTML = "";

  // if nothing found
  if (results.length === 0) {
    list.innerHTML = "<li>No places found</li>";
    return;
  }

  // add each place to the list
  for (let place of results) {
    // create the <li>
    const li = document.createElement("li");

    // create name div
    const nameDiv = document.createElement("div");
    nameDiv.className = "poi-name";
    nameDiv.textContent = place.name;

    // create meta div
    const metaDiv = document.createElement("div");
    metaDiv.className = "poi-meta";

    // distance
    const distSpan = document.createElement("span");
    distSpan.textContent = place.distance + " km away";

    // category
    const typeSpan = document.createElement("span");
    typeSpan.className = "chip";
    typeSpan.textContent = place.types.join(", ");

    // put distance + category into metaDiv
    metaDiv.appendChild(distSpan);
    metaDiv.appendChild(typeSpan);

    // put name + meta into li
    li.appendChild(nameDiv);
    li.appendChild(metaDiv);

    // add li into the list
    list.appendChild(li);
  }
}

   function sendall() {
  navigator.geolocation.getCurrentPosition(handlePosition,handleError);
}

async function handlePosition(pos) {
  const lat = pos.coords.latitude;
  const lon = pos.coords.longitude;
  
  const radius = document.getElementById("rad").value;

  const prefs = [];
  document
    .querySelectorAll('input[name="preferences"]:checked')
    .forEach(cb => prefs.push(cb.value));

  console.log("prefs:", prefs);
  console.log("lat/lon:", lat, lon);
  
  const res = await fetch("/api/location", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      lat,
      lon,
      radius,   // <-- matches backend name
      prefs     // <-- matches backend name
    })
  });

  if (!res.ok) {
    const msg = await res.text();
    alert(msg);          // "Invalid Input"
    return;
  }

  const data = await res.json();   // { count, results }
  console.log("Backend data:", data);
 
  renderPlaces(data.results);
  var lati = 19.0605;
  var longi =72.8366;
  initMap(lat, lon, data.results);

  // Initialize 
  //  the map
  
}


  function handleError(err) {
    console.error("Geolocation error:", err);
  }
</script>
</body>
</html>

